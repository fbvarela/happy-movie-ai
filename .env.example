# ── Database (Neon Postgres) ─────────────────────────────
DATABASE_URL=

# ── Auth (Supabase) ─────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── AI Providers (fallback chain — set at least one) ────
# Text/chat: Anthropic > Cohere > Gemini
ANTHROPIC_API_KEY=
COHERE_API_KEY=
GEMINI_API_KEY=

# Vision: Anthropic > Gemini > OpenAI
# (uses keys above + OPENAI_API_KEY)
OPENAI_API_KEY=

# Image generation: OpenAI DALL-E > Google Imagen > fal.ai FLUX
FAL_API_KEY=

# Video generation: Google Veo > fal.ai Kling
# (uses GEMINI_API_KEY or FAL_API_KEY above)

# ── Payments (Stripe) ───────────────────────────────────
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ── Email (Resend) ──────────────────────────────────────
RESEND_API_KEY=

# ── Image Storage (Cloudflare R2) ───────────────────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=

# ── Movie Data (TMDB) ───────────────────────────────────
TMDB_API_KEY=

# ── Video Sources (YouTube) ─────────────────────────────
YOUTUBE_API_KEY=

# ── App ─────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
